# Build with an isolated context (not the repository's filtered .dockerignore):
#   Dockerfile.ci, verify_vllm_runtime.py, vllm-runtime.tar, vllm-runtime.json
# Export vllm-runtime.tar from the original installed site-packages directory,
# including the complete vllm/ tree. Generate the manifest with the verifier
# from that same frozen tree. Do not prune benchmarks, tests, resources or pyc.
#   docker build -f <context>/Dockerfile.ci -t <new-ci-image> <context>
# Never copy the donor's account files, environment or unrelated dependencies.
ARG RUNTIME_IMAGE=harbor.baai.ac.cn/plugin/kunlunxin001-gems5.4.0-tree0.7.0rc2-triton3.6.0-cx0.13.0-plugin0.3.0-vllm0.24.0-cp310-pt29-x64-v5.0.21.47@sha256:04b27d8eb8e638c7fdc20d84230f70b4b860db62cd021b08aa6756abd0c5e8f1
FROM ${RUNTIME_IMAGE}

# The pinned base already includes Git/HTTPS and pytest reporting packages.
# Restore the original package bytes; do not reinstall or upgrade vLLM.
ADD vllm-runtime.tar /root/miniconda/envs/python310_torch29_cuda/lib/python3.10/site-packages/
COPY verify_vllm_runtime.py vllm-runtime.json /tmp/vllm-runtime-check/
RUN python /tmp/vllm-runtime-check/verify_vllm_runtime.py \
    /root/miniconda/envs/python310_torch29_cuda/lib/python3.10/site-packages/vllm \
    --manifest /tmp/vllm-runtime-check/vllm-runtime.json \
    && test -f /root/miniconda/envs/python310_torch29_cuda/lib/python3.10/site-packages/vllm/benchmarks/serve.py

LABEL io.flagos.image.purpose="CI runtime with complete original installed vLLM package"
